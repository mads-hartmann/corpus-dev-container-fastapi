{
	"name": "Corpus Dev Container FastAPI",
	"image": "mcr.microsoft.com/devcontainers/python:3.11",
	"forwardPorts": [8000],
	"portsAttributes": {
		"8000": {
			"label": "FastAPI",
			"onAutoForward": "notify"
		}
	}
}
